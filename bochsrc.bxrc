megs: 32

romimage: file="$HOME/bochs-2.8/bios/BIOS-bochs-latest"
vgaromimage: file="$HOME/bochs-2.8/bios/VGABIOS-lgpl-latest"

floppya: 1_44="dsk/boot.img", status=inserted
ata0: enabled=1, ioaddr1=0x1F0, ioaddr2=0x3F0, irq=14
ata0-master: type=disk, path="dsk/kernel.hdd", mode=flat, cylinders=80, heads=2, spt=18

boot: a

floppy_bootsig_check: disabled=1

log: log/bochsrc.log

mouse: enabled=0

#keyboard: enabled=1, map="$HOME/bochs-2.8/keymaps/x11-pc-us.map"

magic_break: enabled=1
